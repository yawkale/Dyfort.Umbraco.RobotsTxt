<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Version>14.0.0</Version>
		<ContentTargetFolders>.</ContentTargetFolders>
		<Product>Dyfort.Umbraco.RobotsTxt</Product>
		<PackageId>Dyfort.Umbraco.RobotsTxt</PackageId>
		<Title>Dyfort.Umbraco.RobotsTxt</Title>
		<Description>Umbraco plugin return robots.txt by environment settings</Description>
		<PackageTags>umbraco;plugin;package;umbraco-marketplace</PackageTags>
		<RepositoryUrl>https://github.com/yawkale/Dyfort.Umbraco.RobotsTxt</RepositoryUrl>
		<RepositoryType>GIT</RepositoryType>
		<PackageProjectUrl>https://www.dyfort.com/products/umbraco-robots-txt/</PackageProjectUrl>
		<Company>Dyfort</Company>
		<PackageIcon>icon.png</PackageIcon>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Umbraco.Cms.Web.Website" Version="[14,15)" />
		<PackageReference Include="Umbraco.Cms.Api.Management" Version="[14.3.3,15)" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="App_Plugins\Dyfort.Umbraco.RobotsTxt\**">
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			<CopyToPublishDirectory>Always</CopyToPublishDirectory>
		</Content>
		<None Include="build\**">
			<Pack>true</Pack>
			<PackagePath>buildTransitive</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<None Update="icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Update="README.md">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
</Project>
